# Smith server config
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://smith:smith@localhost:5432/smith

# Auth
JWT_SECRET=change-me-in-production-please-this-must-be-long-and-random
JWT_EXPIRES_IN=7d

# Reset link / verification
RESET_TOKEN_TTL_MIN=30
EMAIL_CODE_TTL_MIN=15

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Property data provider — 'rentcast' for real, 'stub' for offline dev.
PROPERTY_PROVIDER=stub
# Required when PROPERTY_PROVIDER=rentcast. Get a key from https://app.rentcast.io
RENTCAST_API_KEY=


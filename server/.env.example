# Smith server config
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://smith:smith@localhost:5432/smith

# Auth
JWT_SECRET=change-me-in-production-please-this-must-be-long-and-random
JWT_EXPIRES_IN=7d

# Reset link / verification
RESET_TOKEN_TTL_MIN=30
EMAIL_CODE_TTL_MIN=15

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Property data provider — 'rentcast' for real, 'stub' for offline dev.
PROPERTY_PROVIDER=stub
# Required when PROPERTY_PROVIDER=rentcast. Get a key from https://app.rentcast.io
RENTCAST_API_KEY=

# Linear — feedback widget posts Signals here. Personal API key (no Bearer
# prefix). Team + label IDs paste verbatim from Linear → Settings.
#
# To find IDs:
#   Team ID  — Settings → Teams → <team> → URL: linear.app/<workspace>/team/<KEY>/all
#              run `query { team(id:"...") { id } }` against the GraphQL API,
#              or copy from a webhook payload.
#   Label IDs — Settings → Labels → click the label, copy the ID from the URL.
#               One label per Signal source (pm / customer) and one per
#               Signal type (bug / idea / question / other).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_LABEL_PM=
LINEAR_LABEL_CUSTOMER=
LINEAR_LABEL_BUG=
LINEAR_LABEL_IDEA=
LINEAR_LABEL_QUESTION=
LINEAR_LABEL_OTHER=

